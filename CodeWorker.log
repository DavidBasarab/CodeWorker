lly cover the logger and the one-line subscription in `Install()` is trivially correct."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":342,"cache_read_input_tokens":92825,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":342},"output_tokens":9,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"7122bdaa-b5f8-4182-9242-3aafc9734c0d","uuid":"3f264b4a-a0a7-461e-bf86-d20f4ad0b41b"}
